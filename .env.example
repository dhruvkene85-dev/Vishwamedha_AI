# Active AI Provider: "gemini", "groq", or "nvidia"
AI_PROVIDER="gemini"

# Groq API Configuration (Ultra-Fast LPU)
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL="openai/gpt-oss-20b"

# Google Gemini AI Studio API Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.0-flash"

# NVIDIA_API_KEY: Required for NVIDIA chat requests. Keep this server-side.
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY_HERE"
# Optional: override the active NVIDIA multimodal model.
NVIDIA_MODEL="meta/muse-glimmer-30b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://vishwamedha-ai.vercel.app/"